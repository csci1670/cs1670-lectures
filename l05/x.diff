diff --git a/l04/user/squares.c b/l04/user/squares.c
index 31b03a4..67b8815 100644
--- a/l04/user/squares.c
+++ b/l04/user/squares.c
@@ -9,6 +9,8 @@
  * formatted in a tabular form.
  */
 
+int global_var = 42;
+
 int main(void) {
   int n = 100;  // Number of squares to compute
   int p = 0;    // Previous square value
