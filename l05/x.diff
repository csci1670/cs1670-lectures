diff --git a/l04/kernel/memlayout.h b/l04/kernel/memlayout.h
index 855e660..cbb02c1 100644
--- a/l04/kernel/memlayout.h
+++ b/l04/kernel/memlayout.h
@@ -20,6 +20,9 @@
